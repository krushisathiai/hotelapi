# Server
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL URL e.g. Neon, Supabase, AWS RDS, Railway)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Database Fallback (Standard individual parameters)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dineflow
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# Password Reset
RESET_TOKEN_EXPIRES_HOURS=1
